# red-team test config — copy to .env and fill in. NEVER commit .env.
# FAIL-CLOSED: ensure `.env` is in .gitignore BEFORE writing anything real here.
# If it can't be confirmed git-ignored, stop — don't write credentials.
#
# Fill in ONLY the accounts for the group you are running now. Start with Group 1
# (A + B; admin only when you reach the privilege-escalation test). Groups are
# independent — provision Group 2 / 3 later. Never print a value from this file in
# a results row or saved script; reference it as $VAR.

# Target under test. Use the LOCAL instance if preview is wired to the prod DB.
TARGET_BASE_URL=http://localhost:3000

# Confirm which DB the target points at (sanity check, not a secret to attack).
# If this is the production DB, STOP and run locally only.
TARGET_DB_NAME=local_dev

# --- Group 1: impersonation subagent accounts ---
RT_IMP_A_EMAIL=
RT_IMP_A_PASSWORD=
RT_IMP_B_EMAIL=
RT_IMP_B_PASSWORD=
RT_IMP_ADMIN_EMAIL=
RT_IMP_ADMIN_PASSWORD=

# --- Group 2: UI-limits subagent accounts ---
RT_UI_A_EMAIL=
RT_UI_A_PASSWORD=
RT_UI_B_EMAIL=
RT_UI_B_PASSWORD=
RT_UI_ADMIN_EMAIL=
RT_UI_ADMIN_PASSWORD=

# --- Group 3: external-vectors subagent accounts ---
RT_EXT_A_EMAIL=
RT_EXT_A_PASSWORD=
RT_EXT_B_EMAIL=
RT_EXT_B_PASSWORD=
RT_EXT_ADMIN_EMAIL=
RT_EXT_ADMIN_PASSWORD=

# Public frontend key (anon/public API key) for attack 1. It is public by design;
# still mask it in shared output so THIS project's key isn't echoed in a results
# row or a saved script (masking here is about not leaking your key, not secrecy).
PUBLIC_ANON_KEY=
